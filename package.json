{
  "name": "@laioutr/app-cap",
  "version": "0.1.2",
  "description": "Self-hosted proof-of-work bot protection for Laioutr actions, built on Cap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laioutr/app-cap.git"
  },
  "license": "MIT",
  "keywords": [
    "laioutr",
    "laioutr-app",
    "bot-protection",
    "proof-of-work",
    "captcha"
  ],
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "third-party-licenses"
  ],
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "pnpm run dev:prepare && nuxi dev playground",
    "dev:build": "pnpm run assets && nuxi build playground",
    "dev:prepare": "pnpm run assets && nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "prepack": "pnpm run assets && nuxt-module-build build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run prepack && changeset publish",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:types": "vue-tsc --noEmit && vue-tsc --noEmit -p src/runtime/server && cd playground && vue-tsc --noEmit",
    "test:watch": "vitest watch",
    "test:e2e:build": "pnpm run assets && nuxi build playground && CAP_BLOCK_AUTOMATED_BROWSERS=false PLAYGROUND_OUTPUT_DIR=.output-open nuxi build playground"
  },
  "browserslist": [
    "> 0.5% and not dead"
  ],
  "dependencies": {
    "@nuxt/kit": "3.16.2",
    "@opentelemetry/api": "^1.9.0",
    "capjs-core": "0.1.5",
    "defu": "6.1.4",
    "h3": "^1.15.0"
  },
  "devDependencies": {
    "@cap.js/wasm": "0.0.8",
    "@cap.js/widget": "0.1.58",
    "@changesets/cli": "^2.31.0",
    "@laioutr-app/ui": "^2.33.1",
    "@laioutr-core/canonical-types": "^0.39.1",
    "@laioutr-core/core-types": "^0.73.0",
    "@laioutr-core/devtools": "^0.73.0",
    "@laioutr-core/frontend-core": "^0.73.0",
    "@laioutr/eslint-config": "^1.8.8",
    "@laioutr/prettier-config": "^1.1.0",
    "@nuxt/devtools": "^2.6.3",
    "@nuxt/module-builder": "1.0.1",
    "@nuxt/schema": "3.16.2",
    "@nuxt/test-utils": "3.19.1",
    "@pinia/colada": "0.17.1",
    "@pinia/colada-nuxt": "0.2.1",
    "@playwright/test": "1.57.0",
    "@types/node": "latest",
    "@vueuse/core": "13.1.0",
    "eslint": "^9.35.0",
    "happy-dom": "^20.14.5",
    "ioredis": "^5.8.0",
    "nuxt": "3.16.2",
    "pako": "2.1.0",
    "pinia": "3.0.2",
    "redis": "^6.2.1",
    "typescript": "5.9.2",
    "vitest": "3.1.1",
    "vue-tsc": "2.2.10"
  },
  "peerDependencies": {
    "@laioutr-core/frontend-core": ">=0.72.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.15.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
